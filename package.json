    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "idb-keyval": "^6.2.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "lodash.defaultsdeep": "^4.6.1",
    "lodash.partition": "^4.6.0",
    "react": "^18.3.1",
