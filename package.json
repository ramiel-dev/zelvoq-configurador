    "lint": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "refresh-kbs": "npm update via-keyboards",
    "preview": "vite preview",
    "build:kbs": "node --import tsx node_modules/via-keyboards/scripts/build-all.ts public/definitions",
    "find-deadcode": "ts-prune"
  },
